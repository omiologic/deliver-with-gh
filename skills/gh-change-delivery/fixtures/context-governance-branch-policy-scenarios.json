  {
    "name": "context-governance-violated-constraint",
    "input": {
      "repository": "example/widgets",
      "direct_consumer_policy": {
        "strategy": "feature",
        "base_branch": "main",
        "branch_pattern": "{type}/{work_item_id}-{slug}",
        "allowed_types": ["feature"],
        "requires_pull_request": true
      },
      "context_governance": {
        "installed": true,
        "resolved_context": {
          "target": "src/widgets",
          "decisions": [],
          "conventions": [],
          "constraints": [
            {
              "constraint_id": "constraint-review-required",
              "scope": "workspace",
              "source": ".github/rules/main",
              "statement": "github_delivery.branching = {\"requires_pull_request\":true}",
              "check": "violated",
              "record": "constraints/review-required.md"
            }
          ],
          "unstructured_sources": [],
          "blockers": [
            {
              "kind": "constraint_violated",
