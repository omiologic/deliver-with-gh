[
  {
    "name": "context-governance-valid-applicable-records",
    "input": {
      "repository": "example/widgets",
      "direct_consumer_policy": null,
      "context_governance": {
        "installed": true,
        "resolved_context": {
          "target": "src/widgets",
          "decisions": [],
          "conventions": [
            {
              "convention_id": "convention-github-feature-branches",
              "scope": "workspace",
              "strength": "default",
              "statement": "github_delivery.branching = {\"strategy\":\"feature\",\"base_branch\":\"main\",\"branch_pattern\":\"{type}/{work_item_id}-{slug}\",\"allowed_types\":[\"feature\",\"fix\"]}",
              "record": "conventions/github-feature-branches.md"
            }
          ],
          "constraints": [
            {
              "constraint_id": "constraint-github-protected-main",
              "scope": "workspace",
              "source": ".github/rules/main",
              "statement": "github_delivery.branching = {\"protected_branches\":[\"main\"],\"requires_pull_request\":true}",
              "check": "satisfied",
              "record": "constraints/github-protected-main.md"
            }
          ],
          "unstructured_sources": ["AGENTS.md"],
          "blockers": []
        }
      }
    },
    "expect": {"status": "resolved", "source": "context_governance"}
  },
