          {"kind": "issue", "repository": "example-org/api", "title": "API", "canonical_refs": {"plan": "plan://launch/v3", "work_item": "WI-API"}},
          {"kind": "issue", "repository": "example-org/web", "title": "Web", "canonical_refs": {"plan": "plan://launch/v3", "work_item": "WI-WEB"}},
          {"kind": "issue", "repository": "partner-org/docs", "title": "Docs", "canonical_refs": {"plan": "plan://launch/v3", "work_item": "WI-DOCS"}},
          {"kind": "draft", "title": "Coordination", "canonical_refs": {"plan": "plan://launch/v3", "work_item": "WI-COMMS"}}
